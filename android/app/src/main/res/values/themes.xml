<resources>
    <style name="Theme.DevNex" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/devnex_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- System splash (Android 12+) shows the mark on brand navy, then hands over to the Compose splash -->
    <style name="Theme.DevNex.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/devnex_brand</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_devnex_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.DevNex</item>
    </style>
</resources>
